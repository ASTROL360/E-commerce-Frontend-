# Copy this file to .env and set your values.

# URL of your deployed backend
# Example: VITE_API_URL=https://your-backend.onrender.com
VITE_API_URL=

# Google sign-in (optional): create an OAuth client ID at
# https://console.cloud.google.com/apis/credentials (type: Web application)
# Add http://localhost:5173 to "Authorized JavaScript origins".
VITE_GOOGLE_CLIENT_ID=
